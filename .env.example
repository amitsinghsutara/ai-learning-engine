# Which LLM backs the AI layer: "ollama" (local, default) or "gemini" (cloud)
PROVIDER=ollama

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Required only when PROVIDER=gemini. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

PORT=3000
DATABASE_PATH=./data/learning.db
